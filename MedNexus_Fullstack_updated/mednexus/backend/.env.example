# Copy this file to ".env" (same folder) and fill in YOUR MySQL details.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=hospital_surge_db

# API port (the frontend dev server proxies /api to this port)
PORT=5000

# Secret used to sign login tokens. Change it to any long random text.
AUTH_SECRET=change-me-to-a-long-random-string

# Optional: restrict browser origins, comma separated (default = allow all)
# CORS_ORIGIN=http://localhost:5173
