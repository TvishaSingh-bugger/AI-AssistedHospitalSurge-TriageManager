{
  "name": "mednexus-backend",
  "version": "1.0.0",
  "private": true,
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "setup-db": "node scripts/setupDb.js",
    "setup-db:reset": "node scripts/setupDb.js --reset",
    "setup-db:no-ml": "node scripts/setupDb.js --skip-ml",
    "seed-users": "node scripts/seedUsers.js",
    "refresh-demo": "node scripts/refreshDemo.js",
    "smoke-test": "node scripts/smokeTest.js",
